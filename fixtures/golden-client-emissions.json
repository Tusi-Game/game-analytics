        "session_id": "s-0001",
        "name": "level_start",
        "kind": "generic",
        "client_event_time": 1752840000000,
        "props": { "level": 3 }
      }
    },
    {
      "case": "track-generic-identified",
      "verb": "identify('u-1'); track('level_start')",

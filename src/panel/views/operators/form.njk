{% extends "layouts/panel.njk" %}
{% from "partials/confirm-modal.njk" import confirmModal %}

{% block content %}
  <div class="max-w-lg">
    <h1 class="text-xl font-semibold mb-4">{{ 'New operator' if isNew else 'Edit operator' }}</h1>

    <form {% if isNew %}hx-post="/panel/operators"{% else %}hx-post="/panel/operators/{{ account.operatorId }}"{% endif %}
          hx-target="#content" hx-select="#content" hx-swap="outerHTML"
          class="rounded-xl bg-white ring-1 ring-slate-200 p-5 space-y-4">
      <div>
        <label class="block text-sm text-slate-600 mb-1">Email</label>
        <input name="email" type="email" required value="{{ account.email }}" class="w-full px-3 py-2 text-sm rounded border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>

      <div>
        <label class="block text-sm text-slate-600 mb-1">Role</label>
        <select name="role" class="w-full px-3 py-2 text-sm rounded border border-slate-300">
          <option value="viewer" {% if account.role == 'viewer' %}selected{% endif %}>Viewer (read-only)</option>
          <option value="admin" {% if account.role == 'admin' %}selected{% endif %}>Admin (read + write)</option>
        </select>
      </div>

      <div>
        <label class="block text-sm text-slate-600 mb-1">Password {% if not isNew %}<span class="text-slate-400">(leave blank to keep current)</span>{% endif %}</label>
        <input name="password" type="password" {% if isNew %}required{% endif %} autocomplete="new-password" class="w-full px-3 py-2 text-sm rounded border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>

      <div class="flex items-center gap-3">
        <button type="submit" class="px-4 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">{{ 'Create operator' if isNew else 'Save changes' }}</button>
        <a href="/panel/operators" hx-get="/panel/operators" hx-target="#content" hx-select="#content" hx-swap="outerHTML" hx-push-url="true" class="text-sm text-slate-500 hover:underline">Cancel</a>
      </div>
    </form>

    {% if not isNew %}
      <div class="mt-5 rounded-xl bg-white ring-1 ring-slate-200 p-5">
        <h2 class="text-sm font-semibold text-slate-700 mb-1">Multi-factor authentication</h2>
        <p class="text-xs text-slate-500 mb-3">MFA is currently {% if account.mfaEnrolled %}<strong>enrolled</strong>{% else %}not enrolled{% endif %}. Resetting clears the stored secret so a new one can be enrolled.</p>
        {% if account.mfaEnrolled %}
          {{ confirmModal('resetmfa-' + account.operatorId, 'Reset MFA',
            'This clears the operator TOTP secret. They will not be prompted for MFA until re-enrolled.',
            '', '/panel/operators/' + account.operatorId + '/reset-mfa', 'post', 'Reset MFA',
            'px-3 py-1.5 text-sm rounded-lg border border-amber-300 text-amber-700 hover:bg-amber-50') }}
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}

{% extends "layouts/panel.njk" %}
{% from "partials/empty-state.njk" import emptyState %}

{% block content %}
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">{{ gameName }} — Config audit</h1>
    <a href="/panel/{{ gameId }}/config" hx-get="/panel/{{ gameId }}/config" hx-target="#content" hx-select="#content" hx-swap="outerHTML" hx-push-url="true" class="text-sm text-brand-600 hover:underline">← Back to config</a>
  </div>

  {% if rows and rows | length > 0 %}
    <div class="rounded-xl bg-white ring-1 ring-slate-200 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-slate-500"><tr>
          <th class="text-left font-medium px-4 py-2">Changed at</th>
          <th class="text-left font-medium px-4 py-2">Operator</th>
          <th class="text-left font-medium px-4 py-2">Key</th>
          <th class="text-left font-medium px-4 py-2">Old</th>
          <th class="text-left font-medium px-4 py-2">New</th>
          <th class="text-left font-medium px-4 py-2">Effective from</th>
        </tr></thead>
        <tbody class="divide-y divide-slate-100">
          {% for r in rows %}
            <tr x-data="{ open: false }">
              <td class="px-4 py-2 text-slate-500">{{ r.changedAt }}</td>
              <td class="px-4 py-2 font-mono text-slate-500">{{ r.operatorId }}</td>
              <td class="px-4 py-2 font-mono text-slate-700">{{ r.configKey }}</td>
              <td class="px-4 py-2 text-slate-600 max-w-xs truncate" @click="open = !open" :class="open ? '' : 'truncate'">{{ r.oldValue if r.oldValue else '—' }}</td>
              <td class="px-4 py-2 text-slate-600 max-w-xs truncate" @click="open = !open" :class="open ? '' : 'truncate'">{{ r.newValue }}</td>
              <td class="px-4 py-2 text-slate-500">{{ r.effectiveFrom }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    {{ emptyState('No config changes yet', 'Config edits are recorded here with the operator and effective time.') }}
  {% endif %}
{% endblock %}

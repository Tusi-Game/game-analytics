{#
  partials/period-selector.njk (T-11.15) — time-range presets. Each button HTMX-
  GETs the same page with ?period=, swapping #content. `baseHref` = the page URL,
  `period` = the active preset, `extra` = optional extra query (e.g. currency=).
#}
{% macro periodSelector(baseHref, period, extra='') %}
  {% set qextra = ('&' + extra) if extra else '' %}
  <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-sm">
    {% for p in ['24h', '7d', '30d', '90d'] %}
      <a href="{{ baseHref }}?period={{ p }}{{ qextra }}"
         hx-get="{{ baseHref }}?period={{ p }}{{ qextra }}" hx-target="#content" hx-select="#content" hx-swap="outerHTML" hx-push-url="true"
         class="px-3 py-1 rounded-md {% if period == p %}bg-brand-600 text-white{% else %}text-slate-600 hover:bg-slate-100{% endif %}">
        {{ p }}
      </a>
    {% endfor %}
  </div>
{% endmacro %}

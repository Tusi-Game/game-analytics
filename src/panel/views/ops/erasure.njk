{% extends "layouts/panel.njk" %}
{% from "partials/flash.njk" import flash %}

{% macro historyTable(rows, showOutcome) %}
  <table class="min-w-full text-sm">
    <thead class="bg-slate-50 text-slate-500"><tr>
      <th class="text-left font-medium px-4 py-2">Requested at</th>
      <th class="text-left font-medium px-4 py-2">Subject (hashed)</th>
      <th class="text-left font-medium px-4 py-2">Operator</th>
      <th class="text-left font-medium px-4 py-2">Outcome</th>
    </tr></thead>
    <tbody class="divide-y divide-slate-100">
      {% for r in rows %}
        <tr>
          <td class="px-4 py-2 text-slate-500">{{ r.requestedAt }}</td>
          <td class="px-4 py-2 font-mono text-slate-500 text-xs truncate max-w-[10rem]">{{ r.subjectRef }}</td>
          <td class="px-4 py-2 font-mono text-slate-500 text-xs">{{ r.operatorId }}</td>
          <td class="px-4 py-2"><span class="px-2 py-0.5 text-xs rounded bg-slate-100 text-slate-600">{{ r.outcome }}</span></td>
        </tr>
      {% else %}<tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No requests yet.</td></tr>{% endfor %}
    </tbody>
  </table>
{% endmacro %}

{% macro requestForm(gameId, action, verb, label) %}
  <form hx-post="{{ action }}" hx-target="#content" hx-select="#content" hx-swap="outerHTML" class="space-y-3">
    <div>
      <label class="block text-xs font-medium text-slate-500 mb-1">User ID</label>
      <input name="userId" required class="w-full px-3 py-2 text-sm rounded border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500" />
    </div>
    <div>
      <label class="block text-xs font-medium text-slate-500 mb-1">Verification note (attestation)</label>
      <input name="attestation" required placeholder="How you verified this user's identity" class="w-full px-3 py-2 text-sm rounded border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500" />
    </div>
    <label class="flex items-start gap-2 text-sm text-slate-600">
      <input type="checkbox" required class="mt-0.5" />
      <span>I have verified this user's identity out of band. This action is irreversible for erasure.</span>
    </label>
    <button type="submit" class="px-3 py-1.5 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">{{ label }}</button>
  </form>
{% endmacro %}

{% block content %}
  {{ flash(flash) }}
  <h1 class="text-xl font-semibold mb-1">{{ gameName }} — Erasure / DSAR</h1>
  <p class="text-sm text-slate-500 mb-4">Requests run <strong>synchronously</strong> — submit returns an immediate result. History is the attestation trail (subject IDs are hashed, never stored in plaintext).</p>

  <div x-data="{ tab: 'erasure' }">
    <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-sm mb-4">
      <button type="button" @click="tab = 'erasure'" :class="tab === 'erasure' ? 'bg-brand-600 text-white' : 'text-slate-600'" class="px-3 py-1 rounded-md">Erasure</button>
      <button type="button" @click="tab = 'access'" :class="tab === 'access' ? 'bg-brand-600 text-white' : 'text-slate-600'" class="px-3 py-1 rounded-md">Access (DSAR)</button>
    </div>

    {# Erasure tab #}
    <div x-show="tab === 'erasure'">
      {% if canSubmit %}
        <div class="rounded-xl bg-white ring-1 ring-slate-200 p-4 mb-6">
          <h2 class="text-sm font-semibold text-red-700 mb-1">Submit erasure request</h2>
          <p class="text-xs text-slate-500 mb-3">User spine, payer spine, and purchase idempotency records are irreversibly erased. Aggregate metrics are unaffected.</p>
          {{ requestForm(gameId, '/panel/' + gameId + '/ops/erasure', 'post', 'Submit erasure request') }}
        </div>
      {% else %}
        <div class="mb-6 text-sm text-slate-500">You have read-only access. Submitting erasure requests requires an admin role.</div>
      {% endif %}
      <div class="rounded-xl bg-white ring-1 ring-slate-200 overflow-x-auto">
        <h2 class="text-sm font-semibold text-slate-700 p-4 border-b border-slate-100">Erasure history</h2>
        {{ historyTable(erasureHistory, true) }}
      </div>
    </div>

    {# Access tab #}
    <div x-show="tab === 'access'" x-cloak>
      {% if canSubmit %}
        <div class="rounded-xl bg-white ring-1 ring-slate-200 p-4 mb-6">
          <h2 class="text-sm font-semibold text-slate-700 mb-1">Submit access request (GDPR Art. 15/20)</h2>
          <p class="text-xs text-slate-500 mb-3">Assembles a machine-readable export for the subject. The export is returned inline in the synchronous model.</p>
          {{ requestForm(gameId, '/panel/' + gameId + '/ops/dsar', 'post', 'Submit access request') }}
        </div>
      {% else %}
        <div class="mb-6 text-sm text-slate-500">You have read-only access. Submitting access requests requires an admin role.</div>
      {% endif %}
      <div class="rounded-xl bg-white ring-1 ring-slate-200 overflow-x-auto">
        <h2 class="text-sm font-semibold text-slate-700 p-4 border-b border-slate-100">Access history</h2>
        {{ historyTable(dsarHistory, true) }}
      </div>
    </div>
  </div>
{% endblock %}

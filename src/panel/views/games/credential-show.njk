{% extends "layouts/panel.njk" %}
{% from "partials/icons.njk" import icon %}

{% block content %}
  <div class="max-w-2xl mx-auto">
    <div class="rounded-xl bg-white ring-1 ring-amber-300 p-6">
      <div class="flex items-center gap-3 text-amber-700">
        {{ icon('warning', 'h-6 w-6') }}
        <h1 class="text-lg font-semibold">Your new {{ kindLabel }} — shown only once</h1>
      </div>
      <p class="mt-2 text-sm text-slate-600">
        Store this value securely now. For your security it is <strong>never shown again</strong> and cannot be recovered — only its hash is stored.
      </p>

      <div class="mt-4">
        <label class="block text-xs font-medium text-slate-500 mb-1">{{ kindLabel }}</label>
        <div class="flex items-stretch gap-2">
          <input readonly value="{{ raw }}" class="flex-1 px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 font-mono text-sm text-slate-800" />
          <button type="button" data-copy="{{ raw }}" class="px-3 py-2 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm inline-flex items-center gap-1">{{ icon('copy', 'h-4 w-4') }} Copy</button>
        </div>
        <p class="mt-1 text-xs text-slate-400">Prefix: <span class="font-mono">{{ prefix }}</span></p>
      </div>

      <div class="mt-6 flex justify-end">
        <a href="/panel/{{ gameId }}/settings" hx-get="/panel/{{ gameId }}/settings" hx-target="#content" hx-select="#content" hx-swap="outerHTML" hx-push-url="true"
           class="px-4 py-2 rounded-lg bg-brand-600 text-white hover:bg-brand-700 text-sm">I've saved this credential</a>
      </div>
    </div>
  </div>
{% endblock %}

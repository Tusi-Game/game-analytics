{% extends "layouts/panel.njk" %}
{% from "partials/chart-fragment.njk" import chartFragment %}
{% from "partials/metric-card.njk" import metricCard %}
{% from "partials/empty-state.njk" import emptyState %}
{% from "partials/icons.njk" import icon %}

{% block content %}
  <h1 class="text-xl font-semibold mb-1">{{ gameName }} — Classic Day-N Retention</h1>
  <p class="text-sm text-slate-500 mb-4">Cohort-based retention. Immature cells (day N not yet elapsed) show <span class="font-mono">N/A</span>, never a misleading number.</p>

  {% if hasData %}
    {% if headlineCards and headlineCards | length > 0 %}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        {% for c in headlineCards %}{{ metricCard(c) }}{% endfor %}
      </div>
    {% endif %}

    <div class="rounded-xl bg-white ring-1 ring-slate-200 p-4 mb-6">
      <h2 class="text-sm font-semibold text-slate-700 mb-3">Retention curve <span class="text-xs font-normal text-slate-400">(D0 = 100%)</span></h2>
      {{ chartFragment(curveChart, '16rem') }}
    </div>

    <div class="rounded-xl bg-white ring-1 ring-slate-200 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-left font-medium px-4 py-2">Cohort</th>
            <th class="text-right font-medium px-4 py-2">Size</th>
            {% for o in offsets %}<th class="text-right font-medium px-4 py-2">D{{ o }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for row in rows %}
            <tr>
              <td class="px-4 py-2 font-mono text-slate-700">{{ row.cohortDate }}</td>
              <td class="px-4 py-2 text-right text-slate-600">
                {{ row.cohortSize }}
                {% if row.lowConfidence %}<span title="Small cohort — interpret with caution" class="text-amber-500 align-middle">{{ icon('warning', 'h-4 w-4') }}</span>{% endif %}
              </td>
              {% for cell in row.cells %}
                <td class="px-4 py-2 text-right {% if cell.immature %}text-slate-300{% elif cell.lowConfidence %}text-amber-600{% else %}text-slate-800{% endif %}">
                  {{ cell.display }}{% if cell.provisional %}<span class="ml-1 text-[10px] text-amber-500">•</span>{% endif %}
                </td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    {{ emptyState('No cohorts yet', 'Retention cohorts appear once users install and return.') }}
  {% endif %}
{% endblock %}

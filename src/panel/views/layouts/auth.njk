{#
  layouts/auth.njk (T-11.11) — minimal centered-card layout for login + MFA.
  Dark background, no sidebar/topbar. Self-hosted assets only (P4).
#}
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ panelTitle | default('Game Analytics') }}</title>
    <link rel="icon" href="/img/logo.svg" />
    <link rel="stylesheet" href="/styles/tailwind.css" />
    <script defer src="/scripts/alpine.min.js"></script>
    <script defer src="/scripts/htmx.min.js"></script>
    <script defer src="/scripts/panel.js"></script>
  </head>
  <body class="h-full bg-slate-900 text-slate-100">
    <main class="min-h-full flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-sm">
        <div class="flex items-center justify-center gap-3 mb-8">
          <img src="{{ logoUrl | default('/img/logo.svg') }}" alt="" class="h-9 w-9" />
          <span class="text-xl font-semibold tracking-tight">{{ panelTitle | default('Game Analytics') }}</span>
        </div>
        <div class="bg-slate-800 rounded-2xl shadow-xl ring-1 ring-white/10 p-6">
          {% block content %}{% endblock %}
        </div>
        <p class="mt-6 text-center text-xs text-slate-500">Operator console</p>
      </div>
    </main>
  </body>
</html>
